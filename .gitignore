# Python env
.venv/
__pycache__/
*.pyc

# Generated media — regenerated deterministically in cloud CI, never committed
production/_staging/
production/*/pages/
production/*/audio/
production/*/slides/
production/*/captions/
production/*/segments/
production/*/*.mp4
production/*/*.srt
production/*/concat.txt
# NOTE: production/index.json (pdf->slug registry) IS committed — CI needs it.

# Derived / per-run artifacts (cloud recomputes; lock ships as a release asset)
production/*/config/timeline.json
production/*/config/render.lock.json

# OS cruft
.DS_Store
